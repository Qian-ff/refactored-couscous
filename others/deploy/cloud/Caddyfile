{
	admin off
	default_sni {$PUBLIC_HOST}
	servers {
		protocols h1 h2
	}
}

{$PUBLIC_HOST} {
	tls {
		issuer acme {
			profile shortlived
		}
	}
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		-Server
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
	}
	@question_input {
		method PUT
		path_regexp question_input_bytes ^/api/v1/content/questions/tasks/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}/input$
	}
	handle @question_input {
		request_body {
			max_size 5242880
		}
		reverse_proxy api:8000
	}
	@content_upload {
		method PUT
		path_regexp content_bytes ^/api/v1/content/uploads/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}/bytes$
	}
	handle @content_upload {
		request_body {
			max_size 22020096
		}
		reverse_proxy api:8000
	}
	handle {
		request_body {
			max_size 2MB
		}
		handle /api/v1/openapi.json {
			respond 404
		}
		handle /api/* {
			reverse_proxy api:8000
		}
		handle /docs* {
			respond 404
		}
		handle /redoc* {
			respond 404
		}
		handle {
			root * /srv
			@fresh path / /index.html /build-info.json
			header @fresh Cache-Control "no-store"
			file_server
		}
	}
}
