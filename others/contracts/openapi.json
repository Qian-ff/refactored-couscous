{
  "components": {
    "schemas": {
      "CourseContext": {
        "properties": {
          "can_create": {
            "title": "Can Create",
            "type": "boolean"
          },
          "colleges": {
            "items": {
              "$ref": "#/components/schemas/OrganizationPublic"
            },
            "title": "Colleges",
            "type": "array"
          },
          "teachers": {
            "items": {
              "$ref": "#/components/schemas/OrganizationPublic"
            },
            "title": "Teachers",
            "type": "array"
          }
        },
        "required": [
          "can_create",
          "colleges",
          "teachers"
        ],
        "title": "CourseContext",
        "type": "object"
      },
      "CourseCreate": {
        "properties": {
          "code": {
            "maxLength": 40,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Code",
            "type": "string"
          },
          "college_id": {
            "format": "uuid",
            "title": "College Id",
            "type": "string"
          },
          "teacher_id": {
            "format": "uuid",
            "title": "Teacher Id",
            "type": "string"
          },
          "title": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "college_id",
          "teacher_id",
          "code",
          "title"
        ],
        "title": "CourseCreate",
        "type": "object"
      },
      "CoursePublic": {
        "properties": {
          "catalog_id": {
            "format": "uuid",
            "title": "Catalog Id",
            "type": "string"
          },
          "code": {
            "title": "Code",
            "type": "string"
          },
          "college_id": {
            "format": "uuid",
            "title": "College Id",
            "type": "string"
          },
          "college_name": {
            "title": "College Name",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "school_id": {
            "format": "uuid",
            "title": "School Id",
            "type": "string"
          },
          "teacher_name": {
            "title": "Teacher Name",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "school_id",
          "college_id",
          "catalog_id",
          "college_name",
          "code",
          "title",
          "teacher_name"
        ],
        "title": "CoursePublic",
        "type": "object"
      },
      "CoursesPublic": {
        "properties": {
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "data": {
            "items": {
              "$ref": "#/components/schemas/CoursePublic"
            },
            "title": "Data",
            "type": "array"
          }
        },
        "required": [
          "data",
          "count"
        ],
        "title": "CoursesPublic",
        "type": "object"
      },
      "GrantPublic": {
        "properties": {
          "college_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "College Id"
          },
          "role": {
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role",
          "college_id"
        ],
        "title": "GrantPublic",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LoginInput": {
        "properties": {
          "password": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "school_code": {
            "maxLength": 40,
            "minLength": 1,
            "title": "School Code",
            "type": "string"
          },
          "username": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "school_code",
          "username",
          "password"
        ],
        "title": "LoginInput",
        "type": "object"
      },
      "Message": {
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "Message",
        "type": "object"
      },
      "OrganizationPublic": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "school_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "School Id"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "OrganizationPublic",
        "type": "object"
      },
      "Token": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "title": "Expires In",
            "type": "integer"
          },
          "token_type": {
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "expires_in"
        ],
        "title": "Token",
        "type": "object"
      },
      "UserPublic": {
        "properties": {
          "active_work_role": {
            "anyOf": [
              {
                "enum": [
                  "student",
                  "teacher",
                  "administrator"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Work Role"
          },
          "available_work_roles": {
            "items": {
              "enum": [
                "student",
                "teacher",
                "administrator"
              ],
              "type": "string"
            },
            "title": "Available Work Roles",
            "type": "array"
          },
          "college": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OrganizationPublic"
              },
              {
                "type": "null"
              }
            ]
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "effective_grants": {
            "items": {
              "$ref": "#/components/schemas/GrantPublic"
            },
            "title": "Effective Grants",
            "type": "array"
          },
          "grants": {
            "items": {
              "$ref": "#/components/schemas/GrantPublic"
            },
            "title": "Grants",
            "type": "array"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "permissions": {
            "items": {
              "type": "string"
            },
            "title": "Permissions",
            "type": "array"
          },
          "school": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OrganizationPublic"
              },
              {
                "type": "null"
              }
            ]
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "display_name",
          "school",
          "college",
          "grants",
          "permissions",
          "available_work_roles",
          "active_work_role",
          "effective_grants"
        ],
        "title": "UserPublic",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "安研通——实验室安全智能协同管理平台",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "operationId": "auth-login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "auth-logout",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "auth-me",
        "parameters": [
          {
            "in": "header",
            "name": "X-Work-Role",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Work-Role"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserPublic"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Me",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/courses": {
      "get": {
        "operationId": "courses-courses",
        "parameters": [
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "X-Work-Role",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Work-Role"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoursesPublic"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Courses",
        "tags": [
          "courses"
        ]
      },
      "post": {
        "operationId": "courses-create_course",
        "parameters": [
          {
            "in": "header",
            "name": "X-Work-Role",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Work-Role"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CourseCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoursePublic"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Create Course",
        "tags": [
          "courses"
        ]
      }
    },
    "/api/v1/courses/context": {
      "get": {
        "operationId": "courses-context",
        "parameters": [
          {
            "in": "header",
            "name": "X-Work-Role",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Work-Role"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseContext"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Context",
        "tags": [
          "courses"
        ]
      }
    },
    "/api/v1/courses/{course_id}": {
      "get": {
        "operationId": "courses-course",
        "parameters": [
          {
            "in": "path",
            "name": "course_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Course Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Work-Role",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Work-Role"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoursePublic"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Course",
        "tags": [
          "courses"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "system-health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response System-Health",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "system"
        ]
      }
    }
  }
}
